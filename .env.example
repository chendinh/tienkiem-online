# Image provider (pick ONE; leave empty = Pollinations, no key, about 1 image per 45 seconds)
# IMAGE_PROVIDER=cloudflare   # cloudflare | fal | together | openai | pollinations | off
# Cloudflare Workers AI, FLUX.1 [schnell], free quota of about 170 images per day
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# fal.ai (official @fal-ai/client, server side only).
#   Character base picture, standing pose and outfit: Nano Banana 2.1 (priced per token; about $0.05 for the 1K base picture, about $0.07 for the 1K standing pose
#   (an edit of the base picture, drawn automatically after it) and about $0.07 for a 1K outfit (2K about $0.09) made from the pose + one icon per worn item). Creatures: FLUX.1 [dev] ($0.025) and FLUX.1 Kontext [pro] ($0.04) for mutated variants.
#   Item icons: FLUX.1 [schnell] ($0.003).
# FAL_KEY=
# FAL_AVATAR_MODEL=google/nano-banana-2.1
# FAL_AVATAR_RES=1K                 # 1K | 2K | 4K
# FAL_OUTFIT_MODEL=google/nano-banana-2.1/edit   # outfit AND standing pose; also tried: fal-ai/nano-banana-pro/edit ($0.15), fal-ai/nano-banana/edit ($0.04, less faithful)
# FAL_OUTFIT_RES=1K                 # 1K (default) | 2K | 4K
# FAL_CREATURE_MODEL=google/nano-banana-2.1   # normal creatures; FLUX dev drew plush-toy animals, not Fantasy Realistic
# FAL_CREATURE_RES=1K                # 1K | 2K | 4K
# FAL_THINKING=medium               # minimal | medium | high (Nano Banana 2.1 only)
# FAL_MODEL=fal-ai/flux/dev
# FAL_EDIT_MODEL=fal-ai/flux-pro/kontext
# FAL_ITEM_MODEL=fal-ai/flux/schnell
# IMAGE_BUDGET_USD=2             # cumulative cap on image spend for paid providers (ledger in the database, table kv)
# Lab /lab/linh-thu (owner only, needs ADMIN_KEY): mutated variants of a creature and looping clips made from a picture. Uses the same FAL_KEY.
# FAL_ANIM_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video   # start and end frame are the same picture, so the clip loops; $0.07 per second, audio off
# FAL_ANIM_SECONDS=5                # 5 | 10
# BLOB_READ_WRITE_TOKEN=            # Vercel Blob (Storage > Blob > connect to the project): the lab's clips are kept there, not in Postgres. Without it they stay in the database.
# LAB_BUDGET_USD=5                  # cumulative cap for the lab, its own ledger (table kv, key lab.usd), apart from IMAGE_BUDGET_USD
# Together AI
# TOGETHER_API_KEY=
# OpenAI (gpt-image-1, supports transparent PNG)
# OPENAI_API_KEY=
# IMAGE_MODEL=
# Safety caps on new pictures per hour (portraits and creatures, and item icons, are counted separately)
# IMAGE_MAX_PER_HOUR=40
# IMAGE_ITEM_MAX_PER_HOUR=150

# Claude (story + image review). Server side only. Put the real key in .env.local, never in this file.
# TUTIEN_ONLINE_AI_KEY=
# AI_BUDGET_USD=3
# STORY_MODEL=claude-haiku-5-5
# IMAGE_QA=1
# ---- Database (REQUIRED). Accounts, saves, ranking, spend ledger, story cache and generated pictures all live in Postgres.
# Tables are created on first use. Any Postgres works (Neon, Supabase, Vercel Postgres ...).
# On Vercel use the POOLED connection string (Neon: "pooled connection", Supabase: transaction pooler, port 6543).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# PG_POOL_MAX=5               # connections per server instance (use 1 with the local PGlite database)
#
# Local development without installing Postgres:  npm run db:dev   (leave it running), then use the URL it prints, for example
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# PG_POOL_MAX=1

# ---- Game server
# TUTIEN_WORLD_SEED=          # seed of the shared Zone_Phenomenon calendar; keep it fixed in production
# TUTIEN_RATES=demo           # development only: rare drops and Dị Biến appear in minutes (default: launch rates from the requirements)
# TUTIEN_TIME_SCALE=20        # development only: server time runs 20x faster (ignored when NODE_ENV=production)
# ---- Mail (password reset, e-mail linking). Without these the mail is only written to the logs table (name = 'outbox.log') and the server console.
# RESEND_API_KEY=             # https://resend.com ; the sender domain must be verified there
# MAIL_FROM=Tiên Kiếm <no-reply@your-domain.com>
# SITE_URL=https://your-domain.com   # used in mail links and pictures; set it in production
# ---- Sign in with Google (optional; the button appears only when both are set). Redirect URI: SITE_URL/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Production checklist (Vercel: Project > Settings > Environment Variables, scope = Production; mark keys as Sensitive; never commit them)
#   DATABASE_URL           required, the pooled connection string
#   TUTIEN_WORLD_SEED      required, any fixed string, never change it once players exist
#   TUTIEN_ONLINE_AI_KEY   optional, story and image review are off without it
#   FAL_KEY (or another image provider key), IMAGE_PROVIDER, IMAGE_BUDGET_USD, AI_BUDGET_USD
#   CRON_SECRET            required for the daily job: any long random string. Vercel Cron sends it as "Authorization: Bearer ..." to /api/cron/daily
#                          (vercel.json runs it every day at 00:05 UTC). It needs TUTIEN_ONLINE_AI_KEY; the creature picture also needs an image provider.
#   ADMIN_KEY              opens the owner's report at /admin (spend on pictures, hours online, items, creatures, daily quest). Any long random string;
#                          without it the page uses CRON_SECRET, and without both it stays closed. Never put it in a NEXT_PUBLIC_ variable.
#   FAL_BILLING_KEY        optional: a second fal key with the BILLING (read) permission. The report page then shows the real balance of the fal account
#                          (GET /v1/account/billing?expand=credits) and what fal really charged per day and model (GET /v1/models/usage).
#                          The key that draws pictures usually cannot read either (HTTP 403).
# DAILY_MODEL=claude-sonnet-5-5   # model that writes the daily chapter and creature (a few cents a day)
# Do NOT set in production: TUTIEN_RATES, TUTIEN_TIME_SCALE.
# Move the data you already have (from ./data) into the production database once:  DATABASE_URL=... npm run db:migrate
# (add --dry first to see what would be copied). Pictures are drawn after the answer is sent, so /api/image asks for up to 300 s,
# the maximum of every Vercel plan with Fluid Compute (on by default).
